# Android app build (npm run build:android): the web app inside the APK.
VITE_NATIVE=android
# The published site: website mode downloads the latest version from here, and the offline maps
# come from its offline/ folder.
VITE_WEB_APP_URL=https://neokrex-source.github.io/junctionnav/
# Traffic headlines collected by the Traffic news workflow (no key needed).
VITE_TRAFFIC_NEWS_URL=https://raw.githubusercontent.com/neokrex-source/junctionnav/traffic-news/news.json
