# Copy to .env and adjust. All are optional; defaults use free public servers.
# OSRM route endpoint (your own server for real use):
VITE_ROUTER_URL=https://routing.openstreetmap.de/routed-car/route/v1/driving
# Overpass endpoints for junction detail, newline or comma separated:
VITE_OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
# Photon geocoder:
VITE_PHOTON_URL=https://photon.komoot.io
# Map: ofm-liberty | ofm-bright | ofm-positron | ofm-dark | maptiler-streets | maptiler-hybrid | custom
VITE_MAP_STYLE=ofm-liberty
VITE_MAPTILER_KEY=
VITE_CUSTOM_STYLE_URL=

# Accounts. Without Supabase settings, accounts are kept in each browser (no server needed).
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon public key>
# Set to false to offer "Continue without an account" on the sign-in screen.
# VITE_AUTH_REQUIRED=true
