# Copy to .env and adjust. All are optional; defaults use free public servers.
# OSRM route endpoint (your own server for real use):
VITE_ROUTER_URL=https://routing.openstreetmap.de/routed-car/route/v1/driving
# Overpass endpoints for junction detail, newline or comma separated:
VITE_OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
# Photon geocoder:
VITE_PHOTON_URL=https://photon.komoot.io
# Map: ofm-liberty | ofm-bright | ofm-positron | ofm-dark | maptiler-streets | maptiler-hybrid | custom
VITE_MAP_STYLE=ofm-liberty
VITE_MAPTILER_KEY=
VITE_CUSTOM_STYLE_URL=

# Accounts and shared places. Without Supabase settings, accounts and your places are kept in
# each browser (no server needed). With them: accounts on every device, sign in with Google and
# Apple (turned on in the Supabase project), and public places (run supabase/shared-places.sql).
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon public key>
# Set to false to offer "Continue without an account" on the sign-in screen.
# VITE_AUTH_REQUIRED=true

# Ground elevation for junction views (Terrarium-encoded PNG tiles, zoom 14).
# VITE_TERRAIN_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png

# Live traffic (optional). A TomTom key from https://developer.tomtom.com (free, no card) gives
# congestion on the map, incidents with spoken warnings, and arrival times with traffic. Users can
# also paste their own key in Settings.
# VITE_TOMTOM_KEY=
# Traffic headlines from Malaysian news (no key), collected by .github/workflows/traffic-news.yml:
# VITE_TRAFFIC_NEWS_URL=https://raw.githubusercontent.com/<owner>/<repo>/traffic-news/news.json

# Google Maps places in search (optional): a Google Cloud key with the Maps JavaScript API and the
# Places UI Kit turned on (the first 10,000 searches a month are free). Restrict it to your site.
# VITE_GOOGLE_MAPS_KEY=
